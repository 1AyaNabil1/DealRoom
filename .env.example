# Copy to .env and fill in what you need: cp .env.example .env
# Never commit .env (it is gitignored).

# --- Gemini (required for coaching and debriefs) ---------------------------
# Google AI Studio API key. Without it the server still starts, /health
# reports "llm_configured": false, /stream replies with an ERROR message and
# /debrief returns a fixed fallback summary.
GOOGLE_API_KEY=

# Model for live coaching cards and the post-call debrief.
DEALROOM_MODEL=gemini-2.5-flash
# Model for the standalone CLI agent (src/agent.py, Gemini Live API).
# Live model names change often; check `python -m scripts.list_models`.
DEALROOM_LIVE_MODEL=gemini-2.0-flash-live-001

# Per-attempt timeout (seconds) and total attempts for each model call.
# Only timeouts, rate limits (429) and 5xx errors are retried.
DEALROOM_LLM_TIMEOUT_S=15
DEALROOM_LLM_MAX_ATTEMPTS=2

# Ask for a coaching card after this many audio chunks from the overlay.
# The overlay sends one chunk every 500 ms, so 20 is roughly 10 seconds.
DEALROOM_CHUNKS_PER_ANALYSIS=20

# --- Server ----------------------------------------------------------------
# Where session state is stored (a local JSON file).
DEALROOM_SESSION_FILE=session_store.json
# Comma-separated list of allowed browser origins for CORS.
DEALROOM_CORS_ORIGINS=*

# --- Optional Google Cloud --------------------------------------------------
# Google Cloud Text-to-Speech is tried first when GCP_PROJECT_ID is set and
# Application Default Credentials are available (gcloud auth
# application-default login). Otherwise /tts falls back to gTTS.
GCP_PROJECT_ID=
# Only used by src/gcp_vertex_demo.py.
GCP_LOCATION=us-central1
VERTEX_ENDPOINT_ID=
